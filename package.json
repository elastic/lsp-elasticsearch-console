{
  "name": "lsp-elasticsearch-console",
  "description": "Language server protocol implementation for an Elasticsearch dev console",
  "version": "0.1.2",
  "author": "Josh Mock <joshua.mock@elastic.co>",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "*"
  },
  "bin": {
    "lsp-elasticsearch-console": "./out/server.js"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.3.1",
    "env-paths": "^4.0.0",
    "tree-sitter": "^0.25.1",
    "tree-sitter-elasticsearch-console": "file:../tree-sitter-elasticsearch-console",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "scripts": {
    "compile": "tsc -b",
    "license-checker": "license-checker --production --onlyAllow='MIT;Apache-2.0;Apache1.1;ISC;BSD-3-Clause;BSD-2-Clause;0BSD'",
    "postcompile": "chmod +x ./out/server.js",
    "precompile": "npm install",
    "test": "vitest run && npm run license-checker"
  },
  "devDependencies": {
    "@types/debug": "4.1.12",
    "@types/node": "24.10.12",
    "@types/node-fetch": "2.6.13",
    "license-checker": "25.0.1",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "vitest": "4.0.18"
  }
}
